FROM python:3.13-slim@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATABASE_URL_FILE=/run/secrets/lums_database_url \
    LUMS_SECRET_KEY_FILE=/run/secrets/lums_secret

RUN groupadd --system --gid 10001 lums \
    && useradd --system --uid 10001 --gid 10001 \
        --home-dir /nonexistent --no-create-home \
        --shell /usr/sbin/nologin lums

WORKDIR /app

COPY server/requirements.txt /app/server/requirements.txt

RUN pip install --no-cache-dir -r /app/server/requirements.txt

COPY server /app/server
COPY docker-entrypoint.postgres.sh /app/docker-entrypoint.postgres.sh

RUN chmod 755 /app/docker-entrypoint.postgres.sh
RUN install -d -m 0755 /run/secrets

WORKDIR /app

EXPOSE 5000

USER 10001:10001

ENTRYPOINT ["/app/docker-entrypoint.postgres.sh"]
